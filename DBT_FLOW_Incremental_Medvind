Step 4:
		
insert into CLONE_ANALYTICS_DEV_FAHMAH.raw.raw_medvind_final ("METADATA$FILENAME", "__META_TIMESTAMP", "__META_LAST_MODIFIED", "__META_FILE_NAME", "__META_PARTITION_DATE", "Datum", "Kst", "Order", "Ordertext", "Timmar", "Personalkatekori", "Planeringsgrupp", "N/F", "Orsak", "Planerade_Timmar", "Konto")
