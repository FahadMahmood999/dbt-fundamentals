--- Incremental load to only process file for Current Month + Previous Month based on time stamp

Step 1:

dbt run -m raw_medvind_incremental

create or replace  table CLONE_ANALYTICS_DEV_FAHMAH.raw.raw_medvind_incremental
         as
        (
select 
METADATA$FILENAME
,SYSDATE() as __META_TIMESTAMP
,SUBSTR(METADATA$FILE_LAST_MODIFIED,1,7) AS __META_LAST_MODIFIED
--,right(left(METADATA$FILENAME,67),38) AS __META_FILE_NAME
,substr(METADATA$FILENAME,30,18) AS __META_FILE_NAME
,to_date(right(left(METADATA$FILENAME,47),6),'YYYYMM') as __META_PARTITION_DATE
,$1 AS "Datum"
,$2 AS "Kst"
,$3 AS "Order"
,$4 AS "Ordertext"
,$5 AS "Timmar"
,$6 AS "Personalkatekori"
,$7 AS "Planeringsgrupp"
,$8 AS "N/F"
,$9 AS "Orsak"
,$10 AS "Planerade_Timmar"
,$11 AS "Konto"
FROM @HQV_MISC.MISC.AZURE_STAGE_ESB_V2_DEV/Manufacturing/Medvind_sweden/
(file_format => hqv_misc.misc.hqv_medvind_csv, 
pattern => '.*MvDataLager_202407_20240708_.*.csv|.*MvDataLager_202406_20240708_.*.csv')
        );


