This approach is used when we don't have any Unique Ley from source /Buisness unabke to provide so we take all column and concate to generate teh Hask Key 


{{ config(materialized='incremental',unique_key='HashKey') }}

WITH CTE_RAW AS (
   select 
	METADATA$FILENAME AS SrcFileName
    ,SYSDATE() as __META_TIMESTAMP
    ,SPLIT_PART(METADATA$FILENAME,'/',-1)||'~'||METADATA$FILE_LAST_MODIFIED AS UniqueFileID
    ,ltrim(rtrim($1)) as "Branch Plant"
    ,$2 as "Item Number"
    ,$3 as "Description"
    ,$4 as "Location"
    ,$5 as "Lot Serial Number"
    ,$6 as "Quantity On Hand"
    ,$7 as "P S"
    ,$8 as "Class Code"
    ,$9 as "Srch: Search Text"
    ,$10 as "Stocking Type"
    ,concat("Item Number",'-',COALESCE("Location",'99'),'-',COALESCE("Lot Serial Number",'99'),'-',ltrim(rtrim("Branch Plant"))) AS UNIQUE_KEY
    ,hash(concat(nvl($1,' '),nvl($2,' '),nvl($3,' '),nvl($4,' '),nvl($5,' '),nvl($6,' '),nvl($7,' '),nvl($8,' '),nvl($9,' '),nvl($10,' '))) as HashKey

FROM @HQV_MISC.MISC.AZURE_STAGE_DF_MANUFACTURING_{{fnGetEnvironmentName()}}/Availability_Test_New/Availability.csv
(file_format => hqv_misc.misc.hqv_csv_df)

)

