select CTE_RAW.* from CTE_RAW
    left join (select this.UniqueFileID from {{this}} this ) this 
    on CTE_RAW.UniqueFileID=this.UniqueFileID 
    where this.UniqueFileID is null 


{%  else  %}

    select  * from CTE_RAW 

