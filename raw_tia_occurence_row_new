/*Use separate CTEs (WITH clauses) to flatten each nested array (occurrence, followUp, actions,organization,investigation ,objectInvolved,Injurybodypart and Injurtype)
Perform LEFT JOINs on main_id to join the results back together.This query preserves the 
hierarchical relationship and returns complete data for all nested arrays and fields. Added by Fahad*/

with cte_final as (


WITH CTE_base AS (
SELECT
SrcFileName,
json_data.value:id::STRING AS main_id,
json_data.value:serialNumber::STRING AS serialNumber,
json_data.value:occurrence AS occurrence,
json_data.value:followUp AS followUp,
json_data.value:actions AS actions,
json_data.value:claims AS claims,
json_data.value:riskAssessment AS riskAssessment,
json_data.value:organization AS organization,
json_data.value:investigation AS investigation,
json_data.value:isGdprRestricted::BOOLEAN AS isGdprRestricted,
json_data.value:isGgprAnonymized::BOOLEAN AS isGgprAnonymized,
json_data.value:updatedDateTime::string as updatedDateTime 
FROM {{ref('raw_stg_tia_json_row_new')}},
LATERAL FLATTEN(input => ORIG_STRING:data) AS json_data
)

